{
  "name": "tei-cts",
  "version": "0.2.0",
  "description": "Parse CTS/CapiTainS TEI XML into citable text units.",
  "keywords": [
    "tei",
    "cts",
    "capitains",
    "perseus",
    "xml",
    "greek",
    "latin",
    "classics"
  ],
  "license": "MIT",
  "author": "Lin Tian",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tianlynn/tei-cts.git"
  },
  "homepage": "https://github.com/tianlynn/tei-cts#readme",
  "bugs": "https://github.com/tianlynn/tei-cts/issues",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "corpus": "npm run build && npm run corpus:fetch && npm run corpus:run && npm run corpus:report && npm run corpus:manifest",
    "corpus:fetch": "node tools/corpus/fetch.mjs",
    "corpus:run": "node tools/corpus/run.mjs",
    "corpus:report": "node tools/corpus/report.mjs",
    "corpus:manifest": "node tools/corpus/manifest.mjs",
    "corpus:normalized": "npm run build && npm run corpus:fetch -- --corpus=normalized && npm run corpus:run -- --corpus=normalized && npm run corpus:report -- --corpus=normalized && npm run corpus:manifest -- --corpus=normalized",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "saxes": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
